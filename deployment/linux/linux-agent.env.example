# Automation Platform Linux Agent configuration

AUTOMATION_PLATFORM_URL=http://127.0.0.1:8000

# Set this after registering the Linux Agent.
AUTOMATION_AGENT_ID=

AUTOMATION_AGENT_NAME="Linux Agent"

# Optional.
# If omitted, the Linux Agent uses the operating system hostname.
# AUTOMATION_AGENT_HOSTNAME=linux-host-01

AUTOMATION_AGENT_HEARTBEAT_SECONDS=60
AUTOMATION_AGENT_REQUEST_TIMEOUT_SECONDS=30

# Required during deployment.
# Store the real value only in:
# /etc/automation-platform/linux-agent.env
#
# Never commit the real Agent API key.
AUTOMATION_AGENT_API_KEY=